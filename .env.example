UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Must exactly match the redirect URL registered in your Upstox app
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/
UPSTOX_MOBILE=
UPSTOX_PIN=
# TOTP secret key shown when you enable authenticator-app 2FA on Upstox
UPSTOX_TOTP_SECRET=
# true = hidden browser (required on servers unless run under xvfb-run)
UPSTOX_HEADLESS=true
